<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Fixed line budget, not wrap_content: this text's content varies
         in wrapped-line-count (the running state adds a fallback-active
         clause that can wrap to a second line on narrower screens), and
         with the buttons below in the same vertical LinearLayout, a
         height that changes on every 5s refresh shifts the whole button
         column under the user's finger. minLines/maxLines both set to 3
         (the longest real case: wrapped running-status line + the
         last-sample line) keeps the layout stable regardless of content. -->
    <TextView
        android:id="@+id/serviceStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:minLines="3"
        android:maxLines="3"
        android:text="@string/notification_title" />

    <Button
        android:id="@+id/toggleServiceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/start_service" />

    <Button
        android:id="@+id/batteryExemptionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/request_battery_exemption" />

    <Button
        android:id="@+id/exportButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/export_csv" />

    <Button
        android:id="@+id/usageAccessButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/grant_usage_access" />

    <Button
        android:id="@+id/shizukuAccessButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/grant_shizuku_access" />

    <TextView
        android:id="@+id/tierStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="monospace"
        android:textSize="13sp" />

</LinearLayout>
